{
    "manifest_version": 2,
    "name": "X 링크 열기",
    "description": "x.com · twitter.com 링크를 NeoFreeBird 앱으로 열어요.",
    "version": "1.0",
    "icons": {
        "48": "icon-48.png",
        "96": "icon-96.png",
        "128": "icon-128.png",
        "256": "icon-256.png",
        "512": "icon-512.png"
    },
    "content_scripts": [{
        "js": [ "content.js" ],
        "matches": [ "*://*.x.com/*", "*://*.twitter.com/*" ],
        "run_at": "document_start"
    }],
    "permissions": [ ]
}
